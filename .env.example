# Which AI provider generates Strudel code: "openrouter" (default, supports
# free models) or "claude" (Anthropic, requires paid API credits).
PROVIDER=openrouter

# --- OpenRouter (used when PROVIDER=openrouter) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Any model id from https://openrouter.ai/models — copy the exact id from a
# model's own "API" tab. Free-tier availability changes over time, so if the
# default below stops working, pick a current ":free" model from that page.
OPENROUTER_MODEL=z-ai/glm-5.2:free

# --- Claude / Anthropic (used when PROVIDER=claude) ---
# Get this from your Anthropic account (requires API billing credits, separate
# from any claude.ai/Claude Code subscription).
CLAUDE_API_KEY=your_claude_api_key_here

# Claude model to use for generation. Anthropic periodically retires dated
# model snapshots, so override this if the default below ever 404s.
# CLAUDE_MODEL=claude-sonnet-5

# Server configuration
PORT=3000

# Strudel configuration
STRUDEL_URL=http://localhost:8000
